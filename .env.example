# Connection string do Postgres do Supabase. Use o "Session pooler" (Project
# Settings > Database > Connection string > Session pooler) — funciona tanto
# para as queries da aplicação quanto para `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxxxxxx:senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Project Settings > API no painel do Supabase.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# Service role key — secreta, uso exclusivo do servidor (nunca expor ao frontend).
SUPABASE_SERVICE_ROLE_KEY=""
# Nome do bucket privado criado no Supabase Storage para os arquivos do portal.
SUPABASE_STORAGE_BUCKET="relatorios"

# Mesma URL do projeto e a anon/public key (Project Settings > API), usadas
# pelo frontend (Vite) para autenticar com o Supabase Auth.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Chave da API da Anthropic (console.anthropic.com). Sem isso, a análise de IA
# roda em modo mock (texto de exemplo) para não travar o desenvolvimento.
ANTHROPIC_API_KEY=""

# --- Fase 2 (entrega ao cliente) — tudo opcional ---

# URL pública do portal, usada para montar o link do relatório (/r/:token) nos
# e-mails. Em produção na Vercel não precisa preencher: o app usa a própria
# origem da requisição. Preencha só se quiser fixar um domínio.
PUBLIC_APP_URL=""

# Envio de e-mail. SEM provedor configurado, o botão "Enviar ao cliente" abre o
# e-mail já preenchido no seu próprio cliente de e-mail (Gmail/Outlook), com o
# link seguro do relatório — não precisa de conta em lugar nenhum. Se um dia
# você criar conta no Resend (https://resend.com, tem plano gratuito), preencha
# abaixo e o MESMO botão passa a enviar automático pelo servidor, com o PDF
# anexado.
RESEND_API_KEY=""
# Remetente verificado no provedor (ex.: "Abrahão Advogados <relatorios@seudominio.com>").
EMAIL_FROM=""

# Usuário de login para testar o portal. Preencha e rode `npm run db:seed`
# para criar (ou atualizar a senha de) esse usuário no Supabase Auth.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
SEED_USER_NAME="Escritório Abrahão"

PORT=3001
NODE_ENV=development
