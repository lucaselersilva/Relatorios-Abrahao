// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Usuários são gerenciados pelo Supabase Auth (schema auth.users), fora do
// Prisma. Uploads/Reports guardam email/nome do autor como snapshot no
// momento da criação em vez de uma relação para essa tabela.

model Client {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  // Mapeamento manual de colunas da planilha -> campo do sistema, quando o nome
  // da coluna foge do padrão (ex.: { "valor": "valor da demanda" }). Guardamos o
  // mais recente por cliente e reaplicamos nos uploads seguintes.
  columnMapping Json?

  uploads  Upload[]
  reports  Report[]
  contacts Contact[]
}

// Contatos do cliente (destinatários dos relatórios). Um cliente pode ter mais
// de um contato (ex.: financeiro + jurídico); `principal` marca quem recebe por
// padrão no envio.
model Contact {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  nome      String
  email     String
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Upload {
  id             String   @id @default(cuid())
  client         Client   @relation(fields: [clientId], references: [id])
  clientId       String
  // periodo é o mês real da carteira em formato "YYYY-MM" — a fonte da verdade
  // para ordenar/comparar meses. mesReferencia é só o rótulo de exibição.
  periodo        String?
  mesReferencia  String
  fileName       String
  fileKey        String
  uploadedAt     DateTime @default(now())
  uploadedByEmail String?
  uploadedByName  String?

  processos Processo[]
  reports   Report[]

  @@unique([clientId, periodo])
}

model Processo {
  id            String   @id @default(cuid())
  upload        Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId      String
  numero        String
  parte         String?
  area          String?
  valor         Decimal? @db.Decimal(18, 2)
  provisao      Decimal? @db.Decimal(18, 2)
  status        String?
  probabilidade String?

  @@index([uploadId, numero])
}

model Report {
  id             String    @id @default(cuid())
  client         Client    @relation(fields: [clientId], references: [id])
  clientId       String
  upload         Upload    @relation(fields: [uploadId], references: [id])
  uploadId       String
  periodo        String?   // "YYYY-MM" — espelha o periodo do Upload de origem
  mesReferencia  String
  status         String    @default("rascunho") // rascunho | analisando | erro | pronto
  movimentacoes  Json?
  narrativas     Json?
  selecionados   Json?
  docxKey        String?
  createdByEmail String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  finalizedAt    DateTime?

  attachments Attachment[]
}

model Attachment {
  id             String   @id @default(cuid())
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String
  processoNumero String
  fileName       String
  fileKey        String
  extractedText  String?
  uploadedAt     DateTime @default(now())
}
